# Node.js
node_modules/
# Dropbox creates numbered duplicates ("node_modules 2/") when it syncs a
# package tree, and those do not match the pattern above. Without this line they
# show up as untracked and a `git add -A` would commit a quarter-gigabyte of them.
node_modules*/
.env
.DS_Store

# Build outputs
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
Thumbs.db

# Playwright
test-results/
# Capture baselines for scripts/visual-diff-list.mjs. Per-machine by design:
# they say what this reviewer has already looked at.
.visual-baseline/
playwright-report/
.playwright/

# Supabase CLI cache (generated by `supabase link`, may contain connection URLs)
supabase/.temp/

# Misc

# Node.js & Package
yarn.lock
package-lock.json

# pnpm
pnpm-lock.yaml

# Environment — real credentials are never committed
.env
.env.*
.env.local
local.env

# Explicit envs for future-proofing
.env.development
.env.production

# Allow the example template (contains no real credentials)
!.env.example

*.log
*.tmp

.cache/

# Logs
# VS Code
.vscode/

npm-debug.log

# OS
# Mac
.DS_Store

# Misc
*.DS_Store


# Editor/IDE
.vscode/
.idea/
.history/

# Docker
# Docker

*.pid


# Ignore local files
local.env


# Ignore coverage
coverage/


# Ignore by default
*.swp
*.swo

# Ignore test snapshots
__snapshots__/
.vercel
.env*

# Persistent anonymous identity for the E2E negative-auth tests (see invite-persistence.spec.js)
tests/e2e/.anon-fixture.json

# Cached verified-Earner session for the E2E suites (holds a live token)
tests/e2e/.earner-session.json
# Its cross-worker lock. Removed in a finally, so it is only ever left behind
# by a run that died holding it — which is exactly when it must not be staged.
tests/e2e/.earner-session.json.lock

# An agent-held owner credential. A refresh token is the whole account.
tests/e2e/.owner-api-key.json
