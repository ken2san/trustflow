# TrustFlow — Supabase credentials
# Copy this file to .env and fill in your project values.
# Get these from: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Cloudflare Turnstile site key — the PUBLIC half, served inside the bundle.
# Required once CAPTCHA protection is enabled on the Supabase project: with
# protection on and no token, every auth endpoint answers 400 captcha_failed
# (measured on production 2026-11-06, reverted within the hour). The secret
# half is set in the Supabase dashboard and must never appear here.
# Absent, the build falls back to Cloudflare's always-passes test key and says
# so on screen, which is correct for local work and wrong for production.
VITE_TURNSTILE_SITE_KEY=
